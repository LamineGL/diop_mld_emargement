            <Font name="Times New Roman Bold" size="20.0" />
         </font>
      </Label>
      <ComboBox fx:id="cmbAnneeScolaire" layoutX="6.0" layoutY="115.0" prefHeight="34.0" prefWidth="235.0" promptText="Selectionner un session" />
      <ComboBox fx:id="cmbMois" layoutX="262.0" layoutY="115.0" prefHeight="34.0" prefWidth="235.0" promptText="Selectionner un semestre" />
   </children>
</AnchorPane>
