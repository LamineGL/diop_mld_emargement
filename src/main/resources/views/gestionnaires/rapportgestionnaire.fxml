<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="715.0" prefWidth="1344.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sn.groupeisi.gestion_professeur_examen_isi_km_l3gl.controllers.Gestionnaire.RapportGestionController">
   <children>
      <Label fx:id="lbTitre" layoutX="286.0" layoutY="14.0" prefHeight="63.0" prefWidth="618.0" text="RAPPORT DE PRESENCE DES PROFESSEURS">
         <font>
            <Font name="Times New Roman Bold" size="25.0" />
         </font>
      </Label>
      <ComboBox fx:id="cmbsemestre" layoutX="512.0" layoutY="115.0" prefHeight="34.0" prefWidth="235.0" promptText="Selectionner un semestre" />
      <BorderPane fx:id="exportPane" layoutX="14.0" layoutY="239.0" prefHeight="715.0" prefWidth="1344.0">

      <left>
            <Button fx:id="btnExportPDF" mnemonicParsing="false" onAction="#exporterPDF" prefHeight="34.0" prefWidth="131.0" style="-fx-background-color: grey;" text="EXPORTER PDF" textFill="WHITE" BorderPane.alignment="CENTER">
               <font>
                  <Font name="Times New Roman Bold" size="12.0" />
               </font>
            </Button>
         </left>
         <center>
            <Button fx:id="btnExportExcel" mnemonicParsing="false" onAction="#exporterExcel" prefHeight="34.0" prefWidth="150.0" style="-fx-background-color: green;" text="EXPORTER EXCEL" BorderPane.alignment="CENTER">

               <font>
                  <Font name="Times New Roman Bold" size="12.0" />
               </font>
            </Button>
         </center>
      </BorderPane>
      <Label fx:id="lblMessage" layoutX="14.0" layoutY="180.0" prefHeight="34.0" prefWidth="294.0" textFill="#ff0909">
