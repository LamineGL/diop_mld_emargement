<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="715.0" prefWidth="1344.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sn.groupeisi.gestion_professeur_examen_isi_km_l3gl.controllers.Gestionnaire.PresenceGestionController">

    <children>
        <!-- Titre -->
        <Label layoutX="270.0" layoutY="14.0" prefHeight="63.0" prefWidth="389.0" text="LISTE DES PRESENCES">
            <font>
                <Font name="Times New Roman Bold" size="25.0" />
            </font>
        </Label>

        <!-- TableView des présences -->
        <TableView fx:id="tablePresences" layoutX="40.0" layoutY="90.0" prefHeight="200.0" prefWidth="700.0">
            <columns>
                <TableColumn fx:id="colNomProf" prefWidth="180.0" text="Nom du Professeur" />
                <TableColumn fx:id="colDateCours" prefWidth="150.0" text="Date du Cours" />
                <TableColumn fx:id="colHeureCours" prefWidth="150.0" text="Heure du Cours" />
                <TableColumn fx:id="colStatut" prefWidth="150.0" text="Statut" />
            </columns>
        </TableView>

        <!-- Bouton Modifier Présence -->
        <Button fx:id="btnModifierPresence" layoutX="14.0" layoutY="346.0" mnemonicParsing="false" onAction="#modifierPresence" prefHeight="40.0" prefWidth="200.0" text="Modifier Présence" />

        <!-- Message d'information -->
        <Label fx:id="lblMessage" layoutX="220.0" layoutY="320.0" prefHeight="30.0" prefWidth="510.0" textFill="red">
            <font>
                <Font name="Times New Roman Bold" size="18.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
